# Match the credentials and host port in the root .env.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg://pipeline:local-development-only@127.0.0.1:5432/pipeline_assistant

# One public GitHub repository to import. No token is needed for public reads.
GITHUB_REPOSITORY=actions/setup-node

# Optional: only used by the explicit local AI-draft command. Never commit real keys.
# GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Optional single-operator private inbox/review access. Unset/blank disables it.
# Generate 32 random bytes with secrets.token_urlsafe(32); never put this in VITE_*.
# REVIEWER_ACCESS_TOKEN=
